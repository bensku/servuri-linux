ARG IMAGE_BASE
FROM registry.opensuse.org/opensuse/tumbleweed:latest AS build

RUN zypper install -y make go1.26

RUN mkdir /home/build

# Build (really, just arrange files of) foomuuri from submodule
COPY foomuuri /home/build/foomuuri
WORKDIR /home/build/foomuuri
RUN make install DESTDIR=/output

# Build Nebula and nebula-netavark
RUN mkdir -p /output/usr/bin
COPY nebula /home/build/nebula
WORKDIR /home/build/nebula
RUN make bin && mv nebula /output/usr/bin && mv nebula-cert /output/usr/bin

RUN mkdir -p /output/usr/lib/netavark
COPY nebula-netavark /home/build/nebula-netavark
WORKDIR /home/build/nebula-netavark
RUN go build -ldflags "-X github.com/bensku/nebula-netavark/network.Build=servuri-custom" ./cmd/nebula-netavarkd \
    && go build ./cmd/nebula-netavark-plugin \
    && mv nebula-netavarkd /output/usr/bin && mv nebula-netavark-plugin /output/usr/lib/netavark/nebula

FROM ${IMAGE_BASE}/base

# Install stuff built from source
COPY --from=build /output /
RUN systemctl enable foomuuri

# Install a bunch of software
# additional networking troubleshooting utils
# foomuuri deps
# container runtime
# shell stuff
# misc admin tools
# SSH server
# disk partitioning tools
# TLP daemon to reduce power usage
# NTP client for time sync
RUN zypper install -y \
    iputils traceroute mtr bind-utils tcpdump netcat-openbsd nftables \
    python314 \
    podman \
    bash-completion jq less \
    nano htop ncdu \
    openssh-server \
    util-linux parted growpart \
    tlp powertop \
    chrony
RUN systemctl enable sshd \
    && systemctl enable tlp \
    && systemctl enable chronyd

COPY images/server-base/config/. /
RUN systemctl enable nebula-netavarkd
